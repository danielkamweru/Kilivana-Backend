# Copy to .env (git-ignored) and fill in real values.
# On Render, set these in the service dashboard instead; DATABASE_URL
# is provided automatically by an attached PostgreSQL service.

# Database Configuration
# Full JDBC URL, or leave unset on Render where DATABASE_URL wins.
DB_URL=jdbc:postgresql://localhost:5432/kilivana
DB_USERNAME=
DB_PASSWORD=
# Render's standard variable; a full postgres:// URL. Takes precedence
# over DB_URL/DB_USERNAME/DB_PASSWORD when present.
DATABASE_URL=

# Server Configuration
# Render provides PORT; the application listens on it.
PORT=8080

# CORS Configuration (comma-separated allowed origins).
# Local development by default; a deployment sets the frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://127.0.0.1:4200

# JWT Secret (Base64 or raw, at least 32 bytes). Required for any
# shared or deployed environment - without it every restart invalidates
# all issued tokens.
JWT_SECRET=
# Token lifetimes in milliseconds. 0 means no expiry (local development
# only).
JWT_EXPIRATION=0
JWT_REFRESH_EXPIRATION=0

# Public base URL advertised in Swagger and image links, for example
# https://kilivana-backend.onrender.com. Blank means Swagger "Try it
# out" calls whatever host the UI was opened from.
PUBLIC_BASE_URL=

# Seed data (demo population of the database). The initial administrator
# uses SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD; when SEED_ADMIN_PASSWORD is
# blank the administrator account is not created. Other demo accounts
# share SEED_DEMO_PASSWORD.
SEED_DATA=false
SEED_ADMIN_EMAIL=admin@kilivana.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=Kilivana#2026
# When true, reset a seeded account's password to the configured
# value if it no longer matches. Use for a demo environment whose
# seeded accounts are the intended logins; leave false in production.
SEED_ENFORCE_PASSWORDS=false

# Image storage: local (disk), database (PostgreSQL bytea, the default
# and the right choice on Render), or cloudinary.
STORAGE_PROVIDER=database
STORAGE_FALLBACK_PROVIDER=database
STORAGE_LOCAL_DIRECTORY=./uploads

# Cloudinary Configuration (only when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid Configuration (optional; the backend starts without it and
# logs delivery codes instead of sending mail)
SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@kilivana.com
SENDGRID_FROM_NAME=Kilivana

# Actuator Management Endpoints
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# OpenAPI/Swagger
SWAGGER_ENABLED=true
API_DOCS_ENABLED=true

SELECT 'image-large-object-bytes'::text,count(*)::bigint,md5(coalesce(string_agg(md5(lo_get(data)),'' ORDER BY id),'')) FROM public.stored_images
;
DO $$ BEGIN
    IF EXISTS (SELECT * FROM kilivana_before EXCEPT SELECT * FROM kilivana_after)
       OR EXISTS (SELECT * FROM kilivana_after EXCEPT SELECT * FROM kilivana_before) THEN
        RAISE EXCEPTION 'Existing records, sequence state or image bytes changed: rollback';
    END IF;
END $$;
SELECT 'Existing rows, sequence state and image bytes preserved' result;
COMMIT;

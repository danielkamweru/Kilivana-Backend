SELECT set_config('kilivana.schema_review_run','8f9dded-forward-v1',true);
\ir ../../../db/migrations/V16__reconciled_tracking_schema.sql
\ir ../../../db/migrations/V17__reconciled_product_payment_fields.sql
\ir ../../../db/migrations/V18__reconciled_payment_checks_order_item_fk.sql
\ir verify.sql
DO $$ BEGIN
    IF EXISTS (SELECT 1 FROM public.products WHERE farm_id IS NOT NULL OR harvest_date IS NOT NULL OR last_inspection_id IS NOT NULL OR low_stock_threshold IS NOT NULL OR quality_grade IS NOT NULL OR status_changed_at IS NOT NULL OR status_changed_by IS NOT NULL OR status_reason IS NOT NULL OR verified_at IS NOT NULL OR verified_by IS NOT NULL OR verified_qty IS NOT NULL)
       OR EXISTS (SELECT 1 FROM public.payments WHERE merchant_request_id IS NOT NULL OR checkout_request_id IS NOT NULL OR phone_number IS NOT NULL OR mpesa_receipt_number IS NOT NULL OR transaction_date IS NOT NULL OR callback_status IS NOT NULL) THEN
        RAISE EXCEPTION 'Unknown historical product/payment fields must remain NULL';
    END IF;
    IF EXISTS (SELECT 1 FROM public.driver_locations) OR EXISTS (SELECT 1 FROM public.driver_latest_location) THEN
        RAISE EXCEPTION 'New tracking tables must start empty';
    END IF;
END $$;
